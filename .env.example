# Local development defaults to embedded PGlite if DATABASE_URL/POSTGRES_URL are unset.
# To choose a persistent local path explicitly, use:
# DATABASE_URL=pglite:./.pglite

# To use the Docker Compose Postgres service instead, uncomment:
# DATABASE_URL=postgres://postgres:password@localhost:5433/learn-coding
# POSTGRES_URL=postgres://postgres:password@localhost:5433/learn-coding

# OAuth login is optional for local development. Configure these only when testing auth flows.
# The OAuth app callback URLs must match:
# - Google: http://localhost:5173/login/google/callback
# - GitHub: http://localhost:5173/login/github/callback
# BASE_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Required when testing GitHub login/connect or pack sync. Use a long random value.
# AUTH_TOKEN_SECRET=
