# Local development defaults to embedded PGlite if DATABASE_URL/POSTGRES_URL are unset.
# To choose a persistent local path explicitly, use:
# DATABASE_URL=pglite:./.pglite

# To use the Docker Compose Postgres service instead, uncomment:
# DATABASE_URL=postgres://postgres:password@localhost:5433/learn-coding
# POSTGRES_URL=postgres://postgres:password@localhost:5433/learn-coding
